<Project>

  <PropertyGroup>
    <!-- Revit 2027 ships on .NET 10 (see RevitAPI.runtimeconfig.json); Dynamo for Revit targets the same TFM. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>1.0.0</Version>

    <!-- A Dynamo package has no dependency resolution of its own - it just loads every
         DLL sitting in bin/. Class-library projects don't copy a referenced project's
         own NuGet dependencies (e.g. ManagedDoom.Engine's DrippyAL/MeltySynth/Silk.NET.OpenAL,
         pulled in for audio) to the output folder by default; this makes sure they land
         there so Pack-Package.ps1 picks them up. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Point this at your local Revit/Dynamo install. Override per-user via
         an environment variable if your install lives somewhere else:
           setx RevitInstallDir "D:\Autodesk\Revit 2027"
         Once Autodesk ships a standalone Dynamo Core SDK NuGet for this
         version, swap the <Reference> HintPaths below for a PackageReference. -->
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit 2027</RevitInstallDir>
    <DynamoForRevitDir>$(RevitInstallDir)\AddIns\DynamoForRevit</DynamoForRevitDir>
  </PropertyGroup>

</Project>
